# QuizNova Backend Environment Configuration Template

# Server Port
PORT=5001

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/quiznova?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/quiznova

# JWT Secrets for Token Authentication (Change these to long random strings in production!)
JWT_SECRET=super_secret_quiznova_token_key_123!
JWT_REFRESH_SECRET=super_refresh_secret_quiznova_456!

# Google OAuth Client ID (from Google Cloud Console -> APIs & Credentials)
GOOGLE_CLIENT_ID=962047454671-aas2vjadtovjebirovvuo9p3t4afc9tj.apps.googleusercontent.com

# Frontend and Backend URLs for links and CORS
APP_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# EMAIL / SMTP CONFIGURATION (Choose ONE of the options below)
# ==============================================================================

# --- OPTION 1: Gmail (Simplest for small scale) ---
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# SMTP_SERVICE=gmail
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_character_app_password
# SMTP_FROM="QuizNova" <your_email@gmail.com>

# --- OPTION 2: Resend (Recommended for production: https://resend.com) ---
# RESEND_API_KEY=re_123456789abcdef
# SMTP_FROM="QuizNova" <noreply@yourdomain.com>

# --- OPTION 3: SendGrid (https://sendgrid.com) ---
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
# SMTP_FROM="QuizNova" <noreply@yourdomain.com>

# --- OPTION 4: Brevo / Sendinblue (https://brevo.com) ---
# SMTP_SERVICE=brevo
# SMTP_USER=your_brevo_login_email@domain.com
# SMTP_PASS=your_brevo_smtp_key
# SMTP_FROM="QuizNova" <noreply@yourdomain.com>

# --- OPTION 5: Custom SMTP (Mailgun, Postmark, AWS SES, Hostinger, etc.) ---
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@yourdomain.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM="QuizNova" <noreply@yourdomain.com>

# NOTE: If all SMTP variables are left blank, QuizNova will automatically run
# in development mode using an ephemeral Ethereal test inbox and log the preview URLs.
